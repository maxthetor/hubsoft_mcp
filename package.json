{
  "name": "hubsoft-mcp",
  "version": "0.5.0",
  "description": "MCP, skill e CLI (não oficiais) para o ERP Hubsoft — use agentes de IA com as permissões do seu próprio usuário.",
  "main": "server/hubsoft-mcp.mjs",
  "scripts": {
    "build": "tsc && node scripts/bundle.mjs",
    "dev": "tsx src/index.ts",
    "probe": "tsx src/probe.ts",
    "inspect": "npx @modelcontextprotocol/inspector node server/hubsoft-mcp.mjs",
    "prepublishOnly": "npm run build",
    "schema": "tsx src/schema.ts",
    "test": "npm run build && node test/e2e.mjs && node test/cli.mjs && node test/multi.mjs",
    "pack": "npm run build && npx -y @anthropic-ai/mcpb pack . hubsoft-mcp.mcpb",
    "prebuild": "node scripts/version.mjs"
  },
  "keywords": [
    "mcp",
    "hubsoft",
    "isp",
    "provedor",
    "claude",
    "erp",
    "mcp-server",
    "model-context-protocol"
  ],
  "author": "Marcelo",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "graphql": "^17.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "type": "module",
  "bin": {
    "hubsoft-mcp": "server/hubsoft-mcp.mjs",
    "hubsoft": "skills/hubsoft/scripts/hubsoft.mjs"
  },
  "files": [
    "server",
    "skills",
    "README.md",
    "LICENSE",
    "PRIVACY.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxthetor/hubsoft_mcp.git"
  },
  "homepage": "https://github.com/maxthetor/hubsoft_mcp#readme",
  "bugs": {
    "url": "https://github.com/maxthetor/hubsoft_mcp/issues"
  }
}
