{
  "name": "hubsoft-mcp",
  "version": "0.2.0",
  "description": "Servidor MCP (não oficial) para o ERP Hubsoft — use o Claude com as permissões do seu próprio usuário do Hubsoft.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "probe": "tsx src/probe.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build",
    "schema": "tsx src/schema.ts",
    "test": "npm run build && node test/e2e.mjs",
    "pack": "npm run build && npx -y @anthropic-ai/mcpb pack . hubsoft-mcp.mcpb",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "hubsoft",
    "isp",
    "provedor",
    "claude",
    "erp"
  ],
  "author": "Marcelo",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "graphql": "^17.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "bin": {
    "hubsoft-mcp": "dist/index.js",
    "hubsoft-mcp-probe": "dist/probe.js",
    "hubsoft-mcp-schema": "dist/schema.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxthetor/hubsoft_mcp.git"
  },
  "homepage": "https://github.com/maxthetor/hubsoft_mcp#readme",
  "bugs": {
    "url": "https://github.com/maxthetor/hubsoft_mcp/issues"
  }
}
